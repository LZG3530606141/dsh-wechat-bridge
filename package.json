{
  "name": "@lzg3530606141/dsh-wechat-bridge",
  "version": "0.1.0",
  "description": "A local WeChat iLink channel and control CLI for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzg3530606141/dsh-wechat-bridge.git"
  },
  "homepage": "https://github.com/lzg3530606141/dsh-wechat-bridge#readme",
  "bugs": {
    "url": "https://github.com/lzg3530606141/dsh-wechat-bridge/issues"
  },
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
